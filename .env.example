# Copy this file to .env and fill in your real API keys.
# Never commit .env to git — it is listed in .gitignore.

# Anthropic — powers the Claude LLM calls
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity — powers web search inside the agent (sonar model, OpenAI-compatible API)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Notion — reads portfolio table and writes weekly briefs
NOTION_API_KEY=your_notion_integration_secret_here
NOTION_DATABASE_ID=your_portfolio_table_database_id_here
NOTION_PARENT_PAGE_ID=your_stock_agent_root_page_id_here

# LangSmith — traces every agent run for observability and debugging
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=stock-agent
